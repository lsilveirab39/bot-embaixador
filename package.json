{
  "name": "unipds-ai-embaixador-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Bot educacional para Discord com LangChain, LangGraph, LangSmith, OpenRouter, RAG e preferências por aluno.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/**/*.test.ts",
    "db:init": "tsx scripts/init-db.ts",
    "db:migrate": "tsx scripts/run-migration.ts sql/003_hash_existing_ids.sql",
    "discord:register": "tsx scripts/register-commands.ts",
    "ingest": "tsx scripts/ingest.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "@langchain/openrouter": "0.4.3",
    "discord.js": "14.27.0",
    "dotenv": "17.4.2",
    "pg": "^8.16.3",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "pino-pretty": "^13.1.3",
    "tsx": "4.22.5",
    "typescript": "^5.9.3"
  }
}
