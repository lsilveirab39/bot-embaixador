# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Defina para registrar slash commands rapidamente em um servidor de teste.
DISCORD_GUILD_ID=
# Lista CSV. Vazio = todos os servidores onde o bot estiver instalado.
ALLOWED_GUILD_IDS=
# Lista CSV. Vazio = todos os canais permitidos.
ALLOWED_CHANNEL_IDS=
ENABLE_REPLY_TRIGGER=true
ENABLE_DIRECT_MESSAGES=false

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENROUTER_SITE_URL=https://example.invalid
OPENROUTER_SITE_NAME=Embaixador IA UNIPDS
OPENROUTER_DENY_DATA_COLLECTION=true

# PostgreSQL + pgvector
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://embaixador:change-me@localhost:5432/embaixador
DATABASE_SSL=false

# RAG
RAG_TOP_K=6
RAG_MIN_SCORE=0.35
RAG_NAMESPACES=course,ai,programming
CHUNK_SIZE=1200
CHUNK_OVERLAP=180
MAX_HISTORY_MESSAGES=8

# Limites
MAX_INPUT_CHARS=6000
MAX_OUTPUT_TOKENS=1400
USER_RATE_LIMIT_PER_MINUTE=8

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=unipds-ai-embaixador
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Aplicação
LOG_LEVEL=info
PORT=3000

# Cargos de recompensa (IDs do Discord)
# Crie os cargos no Server Settings > Roles e cole os IDs aqui
ROLE_ESTRELA=
ROLE_TOP3=
ROLE_GENIO=
ROLE_MENTOR=
ROLE_DEDICADO=
